<script>
    function validte(el) {
        $.getJSON("/data/plz_schweiz.json", function (data) {
            var options = data;
            if (el.value == "") return;
            /*for (var i = 0; i < options.length; i++) {
                if(el.value == options[i].value)
                console.log("y")
                el.style.borderColor  = "green";
                return;
            }*/
            var success = false;
            options.forEach(element => {
                if (el.value == element.plz + " - " + element.ort + " - " + element.kanton) success =
                    true;
            });
            console.log(success)
            if (success == true) return el.style.borderColor = "green";
            el.value = ""
            el.style.borderColor = "red";
        });

    }
    var lang_url = "";
    const urlParams = new URLSearchParams(window.location.search);
  const lang_param = urlParams.get('lang');
    lang_url = "?lang="+lang_param
    document.querySelector('.lang').setAttribute('value', lang_param);
    $("form").submit(function (e) {
        e.preventDefault();
        $('.sub').css('display', 'none')
        $.ajax({
            url: '<%-pre%>/reg',
            type: 'POST',
            cache: false,
            data: $('form').serializeArray(),
            success: function (data) {
                if (data.success == true) {
                    window.location = `/success${lang_url}&num=<%-pre_n%>`;
                } else {
                    if (data.error == "pers") {
                        console.log("pers")
                    }
                    if (data.error == "error") {
                        console.log("error")

                    }
                    $('.sub').css('display', 'block')
                    if (data.error == "addr") {
                        $('.house_p').css('color', 'red')
                        $('.house_p').css('font-size', '120%')
                    }
                }
            },
            error: function (jqXHR, textStatus, err) {
                $('.error').css('display', 'block')
            }
        })
    })
    
</script>